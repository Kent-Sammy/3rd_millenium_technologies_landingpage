# Copy to .env.local (never commit real values).

# Public site URL, used for canonical links, sitemap and social previews.
# Leave empty until the real domain is live: while empty, search engines are
# asked NOT to index the site (on Vercel the *.vercel.app address is used for links).
NEXT_PUBLIC_SITE_URL=

# Server-side only. Where enquiry form submissions are forwarded (CRM, email
# service, Zapier/Make webhook, serverless function...). Leave empty until a
# backend is chosen: the form will then tell visitors their enquiry was NOT sent.
ENQUIRY_WEBHOOK_URL=

# Optional shared secret sent as the "X-Webhook-Secret" header to the webhook.
ENQUIRY_WEBHOOK_SECRET=
